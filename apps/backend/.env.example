# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password
DB_NAME=lentera_db

# JWT Configuration
JWT_ACCESS_SECRET=your_access_token_secret_key_here
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=your_refresh_token_secret_key_here
JWT_REFRESH_EXPIRATION=10h

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Gemini AI essay grading
# Keep the real key only in apps/backend/.env or your deployment secret manager.
GEMINI_API_KEY=your_gemini_api_key

# Application Configuration
NODE_ENV=development
APP_PORT=3001
APP_URL=http://localhost:3001
FRONTEND_URL=https://lenteraalhusna-git-main-sexy-cc.vercel.app

# Google Cloud Storage
GCS_PROJECT_ID=your_google_cloud_project_id
GCS_BUCKET_NAME=your_gcs_bucket_name
# For Vercel, set the service-account values instead of GCS_KEY_FILENAME.
GCS_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GCS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace_with_private_key\n-----END PRIVATE KEY-----\n"
# Local fallback only: path to an ignored service-account JSON file.
GCS_KEY_FILENAME=./gcs-key.json
MAX_FILE_SIZE_MB=10
MAX_TOTAL_STORAGE_GB=4.9
